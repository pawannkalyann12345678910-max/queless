# Queless Firebase Configuration Example
# Replace with your Firebase Project Settings -> Web App credentials
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=queless-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=queless-app
VITE_FIREBASE_STORAGE_BUCKET=queless-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
